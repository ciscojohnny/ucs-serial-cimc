{
    // The only file to edit. Text values stay in quotes. true, false, and null
    // are lowercase and unquoted. Commas go between items, not after the last one.
    // // comments are ignored.
    //
    //   .\Configure-CIMC.ps1 -ComPort COM3 -HostName rack01-ucs01
    //
    // -HostName must match a hostName in "servers" below.


    // -------- Networking that is the SAME for every server -------------------
    "site": {
        "subnetMask":     "255.255.255.0",
        "gateway":        "10.10.20.1",

        // NIC mode:        "dedicated"   |  "shared_lom"   |  "shared_lom_ext"
        //                  "shared_lom_10g"                |  "cisco_card"
        "nicMode":        "dedicated",

        // NIC redundancy:  "none"  |  "active-standby"  |  "active-active"
        //    Note: "active-active" is only valid with a shared_lom* NIC mode.
        "nicRedundancy":  "none",

        // Optional VLAN tag on the CIMC management port.
        "vlanEnabled":    false,
        "vlanId":         0,

        // true disables IPv6 on the CIMC management port. false leaves it unchanged.
        "disableIpv6":    true,

        // Olson timezone name, e.g. "America/Chicago", "Europe/London", "UTC".
        "timezone":       "America/Chicago"
    },


    // The admin password is not stored here. The script prompts for the current
    // password at startup. It asks for a new one only when CIMC is still at the
    // factory default and forces a change.


    // -------- Serial port (CIMC default is 115200 / 8 / N / 1) ----------------
    "serial": {
        "baudRate":   115200,
        "parity":     "None",   // "None" | "Odd" | "Even"
        "dataBits":   8,
        "stopBits":   "One",    // "One" | "OnePointFive" | "Two"
        "handshake":  "None"    // "None" | "XOnXOff" | "RequestToSend"
    },


    // -------- Script behavior (rarely needs editing) -------------------------
    "behavior": {
        "commandTimeoutSec":   20,
        "loginTimeoutSec":     60,
        "interCommandDelayMs": 250
    },


    // -------- Firmware upgrade (optional) ------------------------------------
    // Off unless "enabled" is true or you pass -Firmware.
    // The laptop Ethernet must be on the CIMC subnet. CIMC pulls the ISO over
    // that network, updates and activates every component except the drives, then boots the drive.
    // Leave this window open until the log says the job finished.
    "firmware": {
        "enabled":        false,

        // "http-local" serves isoFolder from this laptop. "url" uses shareUrl.
        "transport":      "http-local",

        // Folder on this laptop, and the ISO file name inside it.
        "isoFolder":      "/Users/you/Desktop/firmware",
        "isoFile":        "ucs-c220m7-huu.iso",

        // null picks the laptop NIC that is on the CIMC subnet.
        "serveHost":      null,
        "servePort":      8000,

        // Used when transport is "url". Example: "http://10.10.10.9/iso/"
        "shareUrl":       null,
        "shareUser":      null,
        "sharePassword":  null,

        // Boot-device names. Used only if the automatic HUU job cannot start:
        // CIMC vDVD first, then KVM DVD, boot drive, and UEFI shell.
        "vmediaVolume":   "firmware",
        "kvmBootName":    "KvmDvd",
        "kvmSubtype":     "KVMMAPPEDDVD",
        "vmediaSubtype":  "CIMCMAPPEDDVD",
        "dvdBootName":    "vDVD",
        "localBootName":  "LocalLUN",
        "localBootType":  "LOCALHDD",
        "uefiShellName":  "UefiShell",
        "uefiShellType":  "UEFISHELL",

        // Power-cycle into the ISO only if the automatic HUU job cannot start.
        "powerCycle":     true,

        // "all" updates and activates every component except drives.
        // "all,hdd" includes drives. Timeout is 30 to 240 minutes.
        "updateComponent":  "all",
        "updateTimeoutMin": 240
    },


    // One block per server. Copy a block to add one. Comma between blocks, not
    // after the last block.
    //   hostName      required   the -HostName value
    //   ipAddress     required   CIMC IPv4
    //   primaryDns    required
    //   secondaryDns  optional   "" if unused
    //   dnsDomain     required
    //   ntpServers    required   1 to 4 servers
    "servers": [

        {
            "hostName":      "rack01-ucs01",
            "ipAddress":     "10.10.20.51",
            "primaryDns":    "10.10.10.10",
            "secondaryDns":  "10.10.10.11",
            "dnsDomain":     "example.lab",
            "ntpServers": [
                "ntp1.example.lab",
                "ntp2.example.lab"
            ]
        },

        {
            "hostName":      "rack01-ucs02",
            "ipAddress":     "10.10.20.52",
            "primaryDns":    "10.10.10.10",
            "secondaryDns":  "10.10.10.11",
            "dnsDomain":     "example.lab",
            "ntpServers": [
                "ntp1.example.lab",
                "ntp2.example.lab"
            ]
        },

        {
            "hostName":      "rack01-ucs03",
            "ipAddress":     "10.10.20.53",
            "primaryDns":    "10.10.10.10",
            "secondaryDns":  "10.10.10.11",
            "dnsDomain":     "example.lab",
            "ntpServers": [
                "ntp1.example.lab",
                "ntp2.example.lab"
            ]
        }

    ]
}
